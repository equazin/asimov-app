generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MASTER — Gestión de tenants, planes, billing
// ============================================================

model Plan {
  id                 String   @id @default(uuid())
  name               String
  tier               String   // trial, basic, pro, enterprise
  priceArs           Decimal  @default(0) @db.Decimal(12, 2)
  priceUsd           Decimal  @default(0) @db.Decimal(12, 2)
  maxUsers           Int      @default(5)
  maxBranches        Int      @default(1)
  maxDocsPerMonth    Int      @default(500)
  maxMobileDevices   Int      @default(1)
  hasAfip            Boolean  @default(false)
  hasPublicApi       Boolean  @default(false)
  hasCustomDomain    Boolean  @default(false)
  hasPrioritySupport Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenants      Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  customDomain    String?  @unique
  logo            String?
  primaryColor    String   @default("#1a1a1a")
  secondaryColor  String   @default("#FF6B1A")
  status          String   @default("active") // active, grace_period, read_only, blocked, cancelled
  planId          String
  country         String   @default("AR")
  timezone        String   @default("America/Argentina/Buenos_Aires")
  currency        String   @default("ARS")
  fiscalId        String?  // CUIT
  fiscalName      String?  // Razón social
  fiscalAddress   String?
  phone           String?
  email           String?
  website         String?
  printHeader     String?  @db.Text
  printFooter     String?  @db.Text
  printTemplateId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan          Plan           @relation(fields: [planId], references: [id])
  users         User[]
  subscriptions Subscription[]
  featureFlags  FeatureFlag[]
  usageRecords  TenantUsage[]
  clients       Client[]
  suppliers     Supplier[]
  products      Product[]
  warehouses    Warehouse[]
  priceLists    PriceList[]
  documents     Document[]
  stockMovements StockMovement[]
  accountMovements AccountMovement[]
  auditLogs     AuditLog[]
  cashAccounts  CashAccount[]
  printTemplates PrintTemplate[]

  @@index([status])
  @@index([planId])
  @@map("tenants")
}

model Subscription {
  id                     String    @id @default(uuid())
  tenantId               String
  planId                 String
  status                 String    @default("trialing") // active, past_due, cancelled, trialing
  paymentProvider        String    @default("manual") // mercadopago, stripe, manual
  externalSubscriptionId String?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan    Plan   @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id               String   @id @default(uuid())
  subscriptionId   String
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("ARS")
  status           String   @default("pending") // pending, paid, failed, refunded
  paymentProvider  String
  externalPaymentId String?
  paidAt           DateTime?
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model FeatureFlag {
  id        String   @id @default(uuid())
  tenantId  String
  feature   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@map("feature_flags")
}

model TenantUsage {
  id           String @id @default(uuid())
  tenantId     String
  month        String // YYYY-MM
  docsCreated  Int    @default(0)
  activeUsers  Int    @default(0)
  storageBytes BigInt @default(0)
  apiCalls     Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@map("tenant_usage")
}

// ============================================================
// AUTH — Usuarios, roles, permisos
// ============================================================

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         String    @default("seller") // owner, admin, seller, warehouse, accountant, readonly
  active       Boolean   @default(true)
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions   Session[]
  documents  Document[]
  auditLogs  AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceName   String?
  origin       String   @default("web") // desktop, mobile, web
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// ERP — Clientes
// ============================================================

model Client {
  id           String   @id @default(uuid())
  tenantId     String
  code         String?
  businessName String
  cuit         String?
  fiscalType   String   @default("final")
  email        String?
  phone        String?
  address      String?
  city         String?
  province     String?
  zipCode      String?
  creditLimit  Decimal  @default(0) @db.Decimal(14, 2)
  priceListId  String?
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  active       Boolean  @default(true)
  notes        String?  @db.Text
  tags         String[] @default([])
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList? @relation(fields: [priceListId], references: [id])
  documents Document[]
  accountMovements AccountMovement[] @relation("ClientAccountMovements")

  @@unique([tenantId, code])
  @@index([tenantId, businessName])
  @@index([tenantId, cuit])
  @@index([tenantId, active])
  @@map("clients")
}

// ============================================================
// ERP — Proveedores
// ============================================================

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  code           String?
  businessName   String
  cuit           String?
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  zipCode        String?
  paymentTermDays Int     @default(0)
  bankName       String?
  bankCbu        String?
  bankAlias      String?
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  active         Boolean  @default(true)
  notes          String?  @db.Text
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]
  accountMovements AccountMovement[] @relation("SupplierAccountMovements")

  @@unique([tenantId, code])
  @@index([tenantId, businessName])
  @@index([tenantId, active])
  @@map("suppliers")
}

// ============================================================
// ERP — Productos y stock
// ============================================================

model Product {
  id           String   @id @default(uuid())
  tenantId     String
  code         String
  barcode      String?
  name         String
  description  String?  @db.Text
  category     String?
  subcategory  String?
  unit         String   @default("un")
  costPrice    Decimal  @default(0) @db.Decimal(14, 2)
  salePrice    Decimal  @default(0) @db.Decimal(14, 2)
  ivaPct       Decimal  @default(21) @db.Decimal(5, 2)
  weight       Decimal? @db.Decimal(10, 3)
  managesStock Boolean  @default(true)
  managesSerial Boolean @default(false)
  minStock     Decimal  @default(0) @db.Decimal(14, 3)
  photos       String[] @default([])
  active       Boolean  @default(true)
  notes        String?  @db.Text
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels    ProductStock[]
  priceListItems PriceListItem[]
  stockMovements StockMovement[]
  documentItems  DocumentItem[]

  @@unique([tenantId, code])
  @@index([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, active])
  @@map("products")
}

model Warehouse {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  address         String?
  afipPointOfSale String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels    ProductStock[]
  stockMovements StockMovement[]
  documents      Document[]

  @@index([tenantId])
  @@map("warehouses")
}

model ProductStock {
  id          String  @id @default(uuid())
  productId   String
  warehouseId String
  qty         Decimal @default(0) @db.Decimal(14, 3)
  reservedQty Decimal @default(0) @db.Decimal(14, 3)
  minQty      Decimal @default(0) @db.Decimal(14, 3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("product_stock")
}

model StockMovement {
  id            String   @id @default(uuid())
  tenantId      String
  productId     String
  warehouseId   String
  type          String   // in, out, adjustment, transfer
  qty           Decimal  @db.Decimal(14, 3)
  date          DateTime @default(now())
  referenceType String?
  referenceId   String?
  notes         String?
  userId        String?
  createdAt     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, date])
  @@map("stock_movements")
}

// ============================================================
// ERP — Listas de precios
// ============================================================

model PriceList {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  currency    String   @default("ARS")
  markupPct   Decimal  @default(0) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items   PriceListItem[]
  clients Client[]

  @@index([tenantId])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid())
  priceListId String
  productId   String
  price       Decimal @db.Decimal(14, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ============================================================
// ERP — Documentos unificados
// ============================================================

model Document {
  id                String    @id @default(uuid())
  tenantId          String
  type              String    // quote, sale_order, invoice, credit_note, debit_note, delivery_note, receipt, purchase_order, goods_receipt, purchase_invoice, payment_order
  number            String
  pointOfSale       String    @default("00001")
  clientId          String?
  supplierId        String?
  counterpartyName  String
  date              DateTime  @db.Date
  dueDate           DateTime? @db.Date
  invoiceType       String?   // A, B, C, E, M
  status            String    @default("draft") // draft, confirmed, cancelled, voided
  currency          String    @default("ARS")
  exchangeRate      Decimal   @default(1) @db.Decimal(14, 6)
  subtotal          Decimal   @default(0) @db.Decimal(14, 2)
  ivaAmount         Decimal   @default(0) @db.Decimal(14, 2)
  otherTaxes        Decimal   @default(0) @db.Decimal(14, 2)
  total             Decimal   @default(0) @db.Decimal(14, 2)
  cae               String?
  caeExpiry         DateTime? @db.Date
  relatedDocumentId String?
  warehouseId       String?
  userId            String
  origin            String    @default("web") // desktop, mobile, web
  notes             String?   @db.Text
  attachments       String[]  @default([])
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client?    @relation(fields: [clientId], references: [id])
  supplier         Supplier?  @relation(fields: [supplierId], references: [id])
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  user             User       @relation(fields: [userId], references: [id])
  relatedDocument  Document?  @relation("RelatedDocuments", fields: [relatedDocumentId], references: [id])
  derivedDocuments Document[] @relation("RelatedDocuments")
  items            DocumentItem[]
  accountMovements AccountMovement[]

  @@unique([tenantId, type, number])
  @@index([tenantId, type, status])
  @@index([tenantId, clientId])
  @@index([tenantId, supplierId])
  @@index([tenantId, date])
  @@index([tenantId, createdAt])
  @@map("documents")
}

model DocumentItem {
  id          String  @id @default(uuid())
  documentId  String
  productId   String?
  code        String
  description String
  unit        String  @default("un")
  qty         Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  ivaPct      Decimal @default(21) @db.Decimal(5, 2)
  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  ivaAmount   Decimal @default(0) @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])

  @@index([documentId])
  @@map("document_items")
}

// ============================================================
// ERP — Cuenta corriente
// ============================================================

model AccountMovement {
  id           String   @id @default(uuid())
  tenantId     String
  entityType   String   // client, supplier
  entityId     String
  documentType String
  documentId   String
  date         DateTime @db.Date
  debit        Decimal  @default(0) @db.Decimal(14, 2)
  credit       Decimal  @default(0) @db.Decimal(14, 2)
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  description  String
  createdAt    DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document  @relation(fields: [documentId], references: [id])
  client   Client?   @relation("ClientAccountMovements", fields: [entityId], references: [id], map: "account_movements_client_fk")
  supplier Supplier? @relation("SupplierAccountMovements", fields: [entityId], references: [id], map: "account_movements_supplier_fk")

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, date])
  @@map("account_movements")
}

// ============================================================
// ERP — Tesorería
// ============================================================

model CashAccount {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  balance     Decimal  @default(0) @db.Decimal(14, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements CashMovement[]

  @@index([tenantId])
  @@map("cash_accounts")
}

model CashMovement {
  id            String   @id @default(uuid())
  accountId     String
  type          String   // income, expense
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime @default(now())
  concept       String?
  referenceType String?
  referenceId   String?
  userId        String?
  createdAt     DateTime @default(now())

  account CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@map("cash_movements")
}

// ============================================================
// AUDITORÍA
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   // create, update, delete, login, logout, impersonate
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  origin     String   @default("web") // desktop, mobile, web, api, system
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// SISTEMA — Secuencias, templates, notificaciones
// ============================================================

model Sequence {
  id       String @id @default(uuid())
  tenantId String
  name     String
  prefix   String @default("")
  last     Int    @default(0)

  @@unique([tenantId, name])
  @@map("sequences")
}

model PrintTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String   // invoice, delivery_note, quote, receipt, purchase_order, etc.
  html      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("print_templates")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  type      String   // stock_low, payment_due, doc_approved, etc.
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, userId, read])
  @@map("notifications")
}
