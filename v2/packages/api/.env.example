# Database
DATABASE_URL="postgresql://asimov:asimov@localhost:5432/asimov_v2?schema=public"

# Auth
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cuenta principal del panel maestro (superadmin) — la crea `npm run db:seed`.
# OBLIGATORIO: el seed falla si estas variables no están definidas.
# Elegí una contraseña fuerte, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SUPERADMIN_EMAIL="superadmin@asimov.app"
SUPERADMIN_PASSWORD=""

# App
PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="asimov-files"
R2_PUBLIC_URL=""

# Billing
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AFIP / ARCA — Facturación electrónica
# Ambiente por defecto: "production" usa los WS productivos; cualquier otro valor → homologación.
AFIP_ENV="homologacion"
# Clave para cifrar en reposo el certificado y la clave privada de cada tenant
# (AES-256-GCM). 32 bytes en hex (64 chars) o base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AFIP_ENC_KEY=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Asimov <no-reply@asimov.app>"
