{
  "name": "asimov-app",
  "productName": "Asimov",
  "version": "4.20.4",
  "description": "Asimov — App de escritorio del ERP Bartez Tecnología.",
  "repository": {
    "type": "git",
    "url": "https://github.com/equazin/asimov-app.git"
  },
  "author": {
    "name": "Bartez Tecnología",
    "email": "ventas@bartez.com.ar"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dev": "npm run build && cross-env BARTEZ_DEV=1 electron .",
    "start": "npm run build && electron .",
    "dist": "npm run build && npm run rebuild:electron && electron-builder",
    "dist:dir": "npm run build && npm run rebuild:electron && electron-builder --dir",
    "smoke-test": "npm run build && node scripts/smoke-test.js",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm run build && npm run rebuild:electron && electron-builder --publish always",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "fast-xml-parser": "^5.9.3",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
